{
  "name": "whiteboard-ai",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "kill-ports": "node scripts/kill-ports.js",
    "start": "npm run kill-ports && concurrently -n fe,be -c cyan,green \"vite\" \"npm run dev --prefix server\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:sillytavern": "node --import tsx scripts/verify-sillytavern.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
